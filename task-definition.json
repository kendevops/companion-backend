{
  "family": "companion-backend",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::125670147062:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "companion-backend",
      "image": "125670147062.dkr.ecr.ap-southeast-2.amazonaws.com/companion-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3001,
          "hostPort": 3001,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgresql://postgres:jackCompanio@database-1.cfyky8s6ucmi.ap-southeast-2.rds.amazonaws.com:5432/companion?schema=public"
        },
        {
          "name": "PORT",
          "value": "3001"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/companion-backend",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024"
}
